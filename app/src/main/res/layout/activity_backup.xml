<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <Button
            android:id="@+id/bu_backup_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back up now"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/bu_data_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Data to back up: -"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/bu_last_backup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Last backup: Never"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Auto Backup"
            android:layout_marginTop="12dp" />

        <Spinner
            android:id="@+id/bu_auto_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/bu_auto_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Auto Backup Setting"
            android:layout_marginTop="8dp" />


    </LinearLayout>

</ScrollView>