<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="32dp"
    android:paddingBottom="24dp"
    android:background="?android:attr/colorBackground">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/select_language_title"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary" />

    <TextView
        android:id="@+id/tv_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/select_language_subtitle"
        android:textSize="14sp"
        android:textColor="?android:attr/textColorSecondary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="20dp"
        android:fillViewport="true">

        <RadioGroup
            android:id="@+id/rg_languages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rb_kannada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/lang_kannada"
                android:textSize="17sp" />

            <RadioButton
                android:id="@+id/rb_english"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/lang_english"
                android:textSize="17sp" />

            <RadioButton
                android:id="@+id/rb_hindi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/lang_hindi"
                android:textSize="17sp" />

            <RadioButton
                android:id="@+id/rb_tamil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/lang_tamil"
                android:textSize="17sp" />

            <RadioButton
                android:id="@+id/rb_telugu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/lang_telugu"
                android:textSize="17sp" />

            <RadioButton
                android:id="@+id/rb_urdu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/lang_urdu"
                android:textSize="17sp" />

            <RadioButton
                android:id="@+id/rb_kannada_translit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/lang_kannada_translit"
                android:textSize="16sp" />

        </RadioGroup>
    </ScrollView>

    <Button
        android:id="@+id/btn_continue"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:text="@string/continue_button"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
