<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/complianceDisclaimerText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_compliance_disclaimer"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/compliance_ai_disclaimer"
            android:textColor="@color/color_error"
            android:textSize="12sp" />

        <!-- ================= LICENSE ================= -->

        <TextView
            android:id="@+id/licenseQuestionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/valid_license_question"
            android:textSize="18sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/licenseStatusRadioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbLicenseHave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/license_have" />

            <RadioButton
                android:id="@+id/rbLicenseNo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/license_no" />

            <RadioButton
                android:id="@+id/rbLicenseUnknown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/license_unknown" />

        </RadioGroup>

        <Button
            android:id="@+id/saveLicenseButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/save_license_info"
            android:textAllCaps="false" />

        <!-- ================= FSSAI ================= -->

        <TextView
            android:id="@+id/fssaiQuestionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/valid_fssai_question"
            android:textSize="18sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/fssaiStatusRadioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbFssaiHave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fssai_have" />

            <RadioButton
                android:id="@+id/rbFssaiNo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fssai_no" />

            <RadioButton
                android:id="@+id/rbFssaiUnknown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fssai_unknown" />

        </RadioGroup>

        <LinearLayout
            android:id="@+id/fssaiDetailsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/fssaiNumberEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/fssai_number_hint"
                android:inputType="textCapCharacters" />

            <EditText
                android:id="@+id/fssaiTypeEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/fssai_type_hint"
                android:inputType="textCapWords" />

            <EditText
                android:id="@+id/fssaiExpiryEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/fssai_expiry_hint"
                android:inputType="date" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/fssaiRequirementsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/fssai_business_type_question"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/fssaiBusinessTypeRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbFssaiRetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/fssai_retail" />

                <RadioButton
                    android:id="@+id/rbFssaiSlaughter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/fssai_slaughter" />

                <RadioButton
                    android:id="@+id/rbFssaiProcessing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/fssai_processing" />

                <RadioButton
                    android:id="@+id/rbFssaiWholesale"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/fssai_wholesale" />

                <RadioButton
                    android:id="@+id/rbFssaiMultiple"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/fssai_multiple" />

                <RadioButton
                    android:id="@+id/rbFssaiBusinessUnknown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/fssai_unknown" />

            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/fssai_turnover_question"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/fssaiTurnoverRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbFssaiTurnover1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/fssai_turnover_1" />

                <RadioButton
                    android:id="@+id/rbFssaiTurnover2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/fssai_turnover_2" />

                <RadioButton
                    android:id="@+id/rbFssaiTurnover3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/fssai_turnover_3" />

                <RadioButton
                    android:id="@+id/rbFssaiTurnoverUnknown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/fssai_unknown" />

            </RadioGroup>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/fssai_water_question"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/fssaiWaterRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbFssaiWaterYes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/yes" />

                <RadioButton
                    android:id="@+id/rbFssaiWaterNo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/no" />

                <RadioButton
                    android:id="@+id/rbFssaiWaterUnknown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/fssai_unknown" />

            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/fssai_surface_question"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/fssaiSurfaceRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbFssaiSurfaceYes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/yes" />

                <RadioButton
                    android:id="@+id/rbFssaiSurfaceNo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/no" />

                <RadioButton
                    android:id="@+id/rbFssaiSurfaceUnknown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/fssai_unknown" />

            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/fssai_floor_question"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/fssaiFloorRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbFssaiFloorYes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/yes" />

                <RadioButton
                    android:id="@+id/rbFssaiFloorNo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/no" />

                <RadioButton
                    android:id="@+id/rbFssaiFloorUnknown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/fssai_unknown" />

            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/fssai_waste_question"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/fssaiWasteRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbFssaiWasteYes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/yes" />

                <RadioButton
                    android:id="@+id/rbFssaiWasteNo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/no" />

                <RadioButton
                    android:id="@+id/rbFssaiWasteUnknown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/fssai_unknown" />

            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/fssai_drainage_question"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/fssaiDrainageRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbFssaiDrainageYes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/yes" />

                <RadioButton
                    android:id="@+id/rbFssaiDrainageNo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/no" />

                <RadioButton
                    android:id="@+id/rbFssaiDrainageUnknown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/fssai_unknown" />

            </RadioGroup>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/fssai_pest_question"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/fssaiPestRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbFssaiPestYes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/yes" />

                <RadioButton
                    android:id="@+id/rbFssaiPestNo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/no" />

                <RadioButton
                    android:id="@+id/rbFssaiPestUnknown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/fssai_unknown" />

            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/fssai_slaughter_operation_question"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/fssaiSlaughterRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbFssaiSlaughterYes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/yes" />

                <RadioButton
                    android:id="@+id/rbFssaiSlaughterNo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/no" />

                <RadioButton
                    android:id="@+id/rbFssaiSlaughterUnknown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/fssai_unknown" />

                <RadioButton
                    android:id="@+id/rbFssaiSlaughterN_a"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/noc_not_applicable" />

            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/fssai_storage_question"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/fssaiStorageRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbFssaiStorageYes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/yes" />

                <RadioButton
                    android:id="@+id/rbFssaiStorageNo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/no" />

                <RadioButton
                    android:id="@+id/rbFssaiStorageUnknown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/fssai_unknown" />

            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/fssai_noc_question"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/fssaiNocRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbFssaiNocYes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/noc_yes_available" />

                <RadioButton
                    android:id="@+id/rbFssaiNocNo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/noc_no_not_available" />

                <RadioButton
                    android:id="@+id/rbFssaiNocUnknown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/fssai_unknown" />

                <RadioButton
                    android:id="@+id/rbFssaiNocNa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/noc_not_applicable" />

            </RadioGroup>

            <Button
                android:id="@+id/saveFssaiButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/save_fssai_info"
                android:textAllCaps="false" />

        </LinearLayout>

        <!-- ================= BUSINESS INFORMATION ================= -->

        <LinearLayout
            android:id="@+id/businessInfoSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/store_location_title"
                android:textStyle="bold" />

            <Button
                android:id="@+id/enterAutoButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/enter_automatically"
                android:textAllCaps="false" />

            <EditText
                android:id="@+id/storeLocationEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="top"
                android:hint="@string/store_location_hint"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="2" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/area_comes_under" />

            <RadioGroup
                android:id="@+id/areaRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbAreaPanchayat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/gram_panchayat" />

                <RadioButton
                    android:id="@+id/rbAreaMunicipality"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/municipality" />

                <RadioButton
                    android:id="@+id/rbAreaUnknown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/fssai_unknown" />

            </RadioGroup>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/road_width" />

            <RadioGroup
                android:id="@+id/roadRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbRoadGreater"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/greater_than_40_ft" />

                <RadioButton
                    android:id="@+id/rbRoadLess"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/less_than_40_ft" />

                <RadioButton
                    android:id="@+id/rbRoadUnknown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/fssai_unknown" />

            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/temple_zone" />

            <RadioGroup
                android:id="@+id/templeRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbTempleYes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/temple_within_50m" />

                <RadioButton
                    android:id="@+id/rbTempleNo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/no_temple_within_50m" />

                <RadioButton
                    android:id="@+id/rbTempleUnknown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/fssai_unknown" />

            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/school_zone" />

            <RadioGroup
                android:id="@+id/schoolRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbSchoolYes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/school_within_100m" />

                <RadioButton
                    android:id="@+id/rbSchoolNo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/no_school_within_100m" />

                <RadioButton
                    android:id="@+id/rbSchoolUnknown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/fssai_unknown" />

            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/khata_status" />

            <RadioGroup
                android:id="@+id/khataRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbKhataA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/khata_a" />

                <RadioButton
                    android:id="@+id/rbKhataB"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/khata_b" />

                <RadioButton
                    android:id="@+id/rbKhataNo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/khata_none" />

                <RadioButton
                    android:id="@+id/rbKhataUnknown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/fssai_unknown" />

            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/neighbor_noc" />

            <RadioGroup
                android:id="@+id/neighborNocRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbNeighborYes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/available" />

                <RadioButton
                    android:id="@+id/rbNeighborNo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/not_available" />

                <RadioButton
                    android:id="@+id/rbNeighborUnknown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/fssai_unknown" />

            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/glazed_tiles_label" />

            <RadioGroup
                android:id="@+id/glazedTilesRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbGlazedYes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/available_as_required" />

                <RadioButton
                    android:id="@+id/rbGlazedNo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/not_available" />

                <RadioButton
                    android:id="@+id/rbGlazedUnknown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
